# App criado em https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Gerado uma única vez em http://127.0.0.1:3000/api/login (rodando `npm run dev`)
SPOTIFY_REFRESH_TOKEN=

# Precisa ser idêntico ao Redirect URI cadastrado no app do Spotify
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/callback

# Contato (e-mail ou URL do projeto) enviado no User-Agent, como o MusicBrainz exige
MUSICBRAINZ_CONTACT=

# Opcional: liga /api/login e /api/callback em produção (desligados por padrão)
# SPOTIFY_ENABLE_SETUP=true

# Opcional: link "Código no GitHub" no rodapé
# NEXT_PUBLIC_REPO_URL=https://github.com/seu-usuario/spotify-dash
